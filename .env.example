TIMEZONE=Europe/Stockholm
IS_LOCAL="f"
ALLOWED_ORIGINS="https://example.com"

MQTT_ENABLED=true
MQTT_BROKER=tcp://192.168.1.92:1883
MQTT_LCD_TOPIC=mqtt-lcd-display
MQTT_USERNAME=user
MQTT_PASSWORD=pass

LETSENCRYPT_CERTFILE=/etc/letsencrypt/live/example.com/fullchain.pem
LETSENCRYPT_KEYFILE=/etc/letsencrypt/live/example.com/privkey.pem

SPOTIFY_URL=https://api.spotify.com/v1
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_OWNER_IDS=your-spotify-account-id
SPOTIFY_CLIENT_IDS=your_spotify_client_id
SPOTIFY_CLIENT_SECRETS=your_spotify_client_secret

SPOTIFY_REDIRECT_URL=https://example.com/api/callback

SPLITFLAP_MODULE_COUNT=24
ALPHABET_OFFSET_UPPER=",+%%9%::,%::"
ALPHABET_OFFSET_LOWER=",%:::::,:,,:"

ALPHABET_CUSTOM_ORDER=" abcdefghijklmnpqrstuvwxy0123456789+-%,:"

# Write order of alphabet in the ESP32
ALPHABET_ESP32_ORDER=" abcdefghijklmnopqrstuvwxyz0123456789.,'"
